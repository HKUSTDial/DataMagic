{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PresenterChartStage",
  "type": "object",
  "required": ["title", "subtitle", "presenterSide", "presenterName", "presenterRole", "activeBeat", "chartData", "unit", "takeaway", "source", "accentColor"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string", "minLength": 1},
    "presenterSide": {"type": "string", "enum": ["left", "right"]},
    "presenterName": {"type": "string", "minLength": 1},
    "presenterRole": {"type": "string", "minLength": 1},
    "activeBeat": {"type": "integer", "minimum": 0},
    "chartData": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["label", "value", "context"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "value": {"type": "number", "minimum": 0},
          "context": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "unit": {"type": "string"},
    "takeaway": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "accentColor": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
  },
  "additionalProperties": false
}
