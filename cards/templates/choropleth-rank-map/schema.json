{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChoroplethRankMap",
  "type": "object",
  "required": [
    "title",
    "subtitle",
    "regions",
    "unit",
    "takeaway",
    "source",
    "accentColor"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "regions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label",
          "value"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "iconSrc": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "unit": {
      "type": "string"
    },
    "takeaway": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "accentColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "fontFamily": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
