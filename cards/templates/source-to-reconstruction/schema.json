{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceToReconstruction",
  "type": "object",
  "required": [
    "title",
    "subtitle",
    "sourceTitle",
    "rows",
    "unit",
    "highlightIndex",
    "takeaway",
    "source",
    "accentColor"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "sourceTitle": {
      "type": "string",
      "minLength": 1
    },
    "rows": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "label",
          "value",
          "sourceText"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "sourceText": {
            "type": "string",
            "minLength": 1
          },
          "iconSrc": {
            "type": "string",
            "minLength": 1,
            "description": "Local public asset path or supplied image URL. Stays attached to this entity."
          }
        },
        "additionalProperties": false
      }
    },
    "unit": {
      "type": "string"
    },
    "highlightIndex": {
      "type": "integer",
      "minimum": 0
    },
    "takeaway": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "accentColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    }
  },
  "additionalProperties": false
}
