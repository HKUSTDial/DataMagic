{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StorySequenceGenerator",
  "type": "object",
  "required": [
    "blueprintId",
    "title",
    "question",
    "takeaway",
    "source",
    "unit",
    "accent",
    "items"
  ],
  "properties": {
    "blueprintId": {
      "enum": [
        "editorial_reveal",
        "change_and_race",
        "composition_to_detail",
        "cause_and_flow",
        "geographic_journey",
        "source_to_claim"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "takeaway": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string"
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "iconSrc": {
            "type": "string",
            "minLength": 1,
            "description": "Local public asset path or supplied image URL. Stays attached to this entity."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
