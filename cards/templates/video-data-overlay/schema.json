{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VideoDataOverlay",
  "type": "object",
  "required": [
    "layout",
    "videoSrc",
    "title",
    "subtitle",
    "source",
    "conclusion",
    "metrics",
    "tracking"
  ],
  "properties": {
    "layout": {
      "enum": [
        "negative_space",
        "tracked_callout"
      ]
    },
    "videoSrc": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "value",
          "unit",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "iconSrc": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "tracking": {
      "type": "object",
      "required": [
        "label",
        "value",
        "unit",
        "color",
        "keyframes"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "keyframes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "frame",
              "x",
              "y"
            ],
            "properties": {
              "frame": {
                "type": "number",
                "minimum": 0
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "iconSrc": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
