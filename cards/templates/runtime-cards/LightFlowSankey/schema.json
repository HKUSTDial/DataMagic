            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "scene": {
      "type": "object",
      "properties": {
        "time_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
