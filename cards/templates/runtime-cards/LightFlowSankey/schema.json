          "const": "StyleTemplate-LightFlowSankey"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "template_payload": {
          "type": "object"
        },
        "style": {
          "type": "object"
        },
        "entity_icons": {
          "type": "object",
