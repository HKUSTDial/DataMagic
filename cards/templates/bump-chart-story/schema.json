{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BumpChartStory",
  "type": "object",
  "required": [
    "title",
    "subtitle",
    "periods",
    "series",
    "takeaway",
    "source"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "periods": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "series": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "name",
          "color",
          "values"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "iconSrc": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "takeaway": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "fontFamily": {
      "type": "string",
      "minLength": 1
    },
    "highlightSeries": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
